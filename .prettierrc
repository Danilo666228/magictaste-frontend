{
	"trailingComma": "none",
	"tabWidth": 4,
	"printWidth": 150,
	"useTabs": true,
	"semi": false,
	"jsxSingleQuote": true,
	"singleQuote": true,
	"arrowParens": "avoid",
	"endOfLine": "auto",
	"singleAttributePerLine": false,
	"bracketSameLine": true,
	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"]
}
